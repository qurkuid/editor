+  const profile = buildOpeningCutoutProfile(opening, {
+    left: position[0] - width / 2,
+    right: position[0] + width / 2,
+    bottom: position[1] - height / 2,
+    top: position[1] + height / 2,
+  })
+  if (profile.length < 3 || profile.some((point) => !isFinitePoint(point))) return null
+  const area = polygonArea(profile)
+  return Number.isFinite(area) && area > 1e-7 ? profile : null
