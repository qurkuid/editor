+/**
+ * Measure a polygon union only when the retained boundary topology can be
+ * proven closed and its containment parity is unambiguous.
+ */
+export function measurePolygonUnionArea(polygons: Point2D[][]): PolygonUnionAreaResult {
+  if (polygons.length === 0) return { ok: true, area: 0 }
+
+  const normalized: Point2D[][] = []
+  let sourceArea = 0
+  for (const polygon of polygons) {
+    if (polygon.length < 3 || polygon.some((point) => !isFinitePoint(point))) {
+      return strictFailure('invalid input polygon')
+    }
+    const ring = normalizeRing(polygon)
+    if (ring.length < 3 || !isSimpleRing(ring) || !isConvexRing(ring)) {
+      return strictFailure('input polygon must be simple and convex')
+    }
+    normalized.push(ring)
+    sourceArea += Math.abs(polygonArea(ring))
+  }
+
+  const assembled = assembleStrictRings(buildBoundarySegments(buildEdges(normalized), normalized))
+  if (!assembled.ok) return assembled
+
+  for (let leftIndex = 0; leftIndex < assembled.rings.length; leftIndex += 1) {
+    const leftRing = assembled.rings[leftIndex]!
+    const leftSegments = leftRing.map((start, index) => ({
+      start,
+      end: leftRing[(index + 1) % leftRing.length]!,
+      used: false,
+    }))
+    for (let rightIndex = leftIndex + 1; rightIndex < assembled.rings.length; rightIndex += 1) {
+      const rightRing = assembled.rings[rightIndex]!
+      const rightSegments = rightRing.map((start, index) => ({
+        start,
+        end: rightRing[(index + 1) % rightRing.length]!,
+        used: false,
+      }))
+      if (
+        leftSegments.some((left) =>
+          rightSegments.some((right) => segmentTouchesSegment(left, right)),
+        )
+      ) {
+        return strictFailure('boundary contact between rings')
+      }
+    }
+  }
+
+  const depths: number[] = []
+  for (let index = 0; index < assembled.rings.length; index += 1) {
+    const ring = assembled.rings[index]!
+    const sample = ring[0]
+    if (!sample) return strictFailure('no provable ring interior')
+    let depth = 0
+    for (let otherIndex = 0; otherIndex < assembled.rings.length; otherIndex += 1) {
+      if (index === otherIndex) continue
+      const other = assembled.rings[otherIndex]!
+      if (
+        other.some((point, pointIndex) =>
+          strictPointOnSegment(sample, point, other[(pointIndex + 1) % other.length]!),
+        )
+      ) {
+        return strictFailure('ring containment touches a boundary')
+      }
+      if (strictPointInPolygon(sample, other)) depth += 1
+    }
+    depths.push(depth)
+  }
+
+  const area = assembled.rings.reduce((total, ring, index) => {
+    const magnitude = Math.abs(polygonArea(ring))
+    return total + (depths[index]! % 2 === 0 ? magnitude : -magnitude)
+  }, 0)
+  const tolerance = EPSILON * Math.max(1, sourceArea)
+  const largestInputArea = Math.max(...normalized.map((ring) => Math.abs(polygonArea(ring))))
+  if (
+    !Number.isFinite(area) ||
+    area < largestInputArea - tolerance ||
+    area > sourceArea + tolerance
+  ) {
+    return strictFailure('union area failed bounds proof')
+  }
+  return { ok: true, area: Math.max(0, area) }
+}
