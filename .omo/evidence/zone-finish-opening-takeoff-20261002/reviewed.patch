+function assembleStrictRings(
+  segments: Segment[],
+): { ok: true; rings: Point2D[][] } | { ok: false; reason: string } {
+  if (segments.length === 0) return { ok: false, reason: 'no boundary segments' }
+
+  const byStart = new Map<string, Segment[]>()
+  const byEnd = new Map<string, Segment[]>()
+  for (const segment of segments) {
+    if (!isFinitePoint(segment.start) || !isFinitePoint(segment.end)) {
+      return { ok: false, reason: 'non-finite boundary segment' }
+    }
+    if (pointsEqual(segment.start, segment.end)) {
+      return { ok: false, reason: 'degenerate boundary segment' }
+    }
+    const key = pointKey(segment.start)
+    const group = byStart.get(key)
+    if (group) group.push(segment)
+    else byStart.set(key, [segment])
+
+    const endGroup = byEnd.get(pointKey(segment.end))
+    if (endGroup) endGroup.push(segment)
+    else byEnd.set(pointKey(segment.end), [segment])
+  }
+  if ([...byStart.values()].some((group) => group.length !== 1)) {
+    return { ok: false, reason: 'ambiguous outgoing boundary' }
+  }
+  if ([...byEnd.values()].some((group) => group.length !== 1)) {
+    return { ok: false, reason: 'ambiguous incoming boundary' }
+  }
+
+  const rings: Point2D[][] = []
+  for (const first of segments) {
+    if (first.used) continue
+    const ring: Point2D[] = []
+    const startKey = pointKey(first.start)
+    let current: Segment | undefined = first
+    let closed = false
+
+    for (let count = 0; count <= segments.length; count += 1) {
+      if (!current || current.used) return { ok: false, reason: 'unclosed boundary walk' }
+      current.used = true
+      ring.push(current.start)
+      const endKey = pointKey(current.end)
+      if (endKey === startKey) {
+        if (!pointsEqual(current.end, ring[0]!)) {
+          return { ok: false, reason: 'boundary key collision' }
+        }
+        closed = true
+        break
+      }
+      const next = byStart.get(endKey)
+      if (next?.length !== 1 || next[0]!.used) {
+        return { ok: false, reason: 'dead-end boundary walk' }
+      }
+      if (!pointsEqual(current.end, next[0]!.start)) {
+        return { ok: false, reason: 'boundary coordinate mismatch' }
+      }
+      current = next[0]
+    }
+
+    if (!closed) return { ok: false, reason: 'boundary walk exceeded segment count' }
+    const normalized = normalizeRing(ring)
+    if (normalized.length < 3 || !isSimpleRing(normalized)) {
+      return { ok: false, reason: 'invalid assembled ring' }
+    }
+    rings.push(normalized)
+  }
+
+  if (segments.some((segment) => !segment.used)) {
+    return { ok: false, reason: 'unused boundary segment' }
+  }
+  return { ok: true, rings }
+}
