+  if (delta > INFERENCE_TOLERANCE + 1e-12) return null
+  const x = Math.cos(target)
+  const z = Math.sin(target)
+  const distance = snapScalar(dx * x + dz * z, step)
+  return [origin[0] + x * distance, origin[1] + z * distance]
