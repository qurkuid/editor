+    !isIsoTimestamp(record.submittedAt) ||
+    !Number.isSafeInteger(record.itemCount) ||
+    !Number.isSafeInteger(record.failedItems) ||
+    (record.itemCount as number) < 0 ||
+    (record.failedItems as number) < 0 ||
+    !Array.isArray(record.items)
+  ) {
