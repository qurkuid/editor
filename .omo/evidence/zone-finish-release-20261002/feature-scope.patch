+    makeWall('wall_top', [4, 4], [0, 4]),
+    makeWall('wall_left', [0, 4], [0, 0]),
+  ]
+  const zone = makeZone()
+  return {
+    nodes: Object.fromEntries([zone, ...walls].map((node) => [node.id, node])),
+    materials: MATERIALS,
+    spaces: { space_room: makeSpace() },
+    ...overrides,
