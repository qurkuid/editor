+        visibleClauses.push("(visibility = 'company' AND company_id = ?)")
+        bindings.push(scope.companyId)
+      }
+    }
+    if (visibleClauses.length === 0) return []
+    const clauses = [`(${visibleClauses.join(' OR ')})`]
+    if (kind) {
+      clauses.push('AND kind = ?')
+      bindings.push(kind)
