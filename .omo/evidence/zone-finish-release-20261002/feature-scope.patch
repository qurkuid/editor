+  async listFinishTemplates(
+    scope: FinishTemplateScope,
+    options: FinishTemplateKind | FinishTemplateListOptions = {},
+  ): Promise<FinishTemplateRecord[]> {
+    if (!scope.ownerId || typeof scope.ownerId !== 'string') {
